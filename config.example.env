# Copy values into your shell environment; do not commit a populated .env file.
NPC_PROJECT_ROOT=C:\absolute\path\to\the\governed\project
NPC_DATA_ROOT=C:\absolute\path\to\source\imaging

# Private pseudonymous IDs required by historical preprocessing audit checks.
NPC_PREPROCESSING_EXCLUDED_ID=<pseudonymous_id>
NPC_SOURCE_QC_WARNING_IDS=<id1>,<id2>
NPC_PREPROCESSING_WARNING_IDS=<id1>,<id2>,<id3>,<id4>

# Pseudonymous cases selected for the manuscript Figure 4 assembly.
NPC_FIG4_DEVELOPMENT_CASE_ID=<pseudonymous_id>
NPC_FIG4_EXTERNAL_CASE_ID=<pseudonymous_id>


# Optional path overrides for immutable local artifacts and generated outputs.
NPC_ANALYSIS_MASTER_XLSX=C:\absolute\path\to\final489_master.xlsx
NPC_SPLIT_OUTPUT_ROOT=C:\absolute\path\to\new_split_output
NPC_TRAIN_ROOT=C:\absolute\path\to\locked_training_artifacts
NPC_DEVELOPMENT_PREDICTIONS_DIR=C:\absolute\path\to\development_aggregate
NPC_EXTERNAL_PREDICTIONS_DIR=C:\absolute\path\to\external_predictions
NPC_CALIBRATION_OUTPUT_DIR=C:\absolute\path\to\calibration_output
NPC_DCA_OUTPUT_DIR=C:\absolute\path\to\dca_output
NPC_GRADCAM_CASES_CSV=C:\absolute\path\to\private_figure4_case_selection.csv
NPC_GRADCAM_OUTPUT_DIR=C:\absolute\path\to\gradcam_output
